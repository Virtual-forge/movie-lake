# Copy to .env.local for personal tokens and .env for shared local values.
# Never commit real values — .env* files are git-ignored on purpose.

# themoviedb.org → Settings → API → "API Read Access Token" (the long JWT).
TMDB_API_READ_TOKEN=

# Better Auth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Local Postgres: docker compose up -d (see docker-compose.yml).
# For Vercel production use a Neon POOLED connection string instead.
DATABASE_URL=postgresql://user:password@localhost:5433/movie_lake

# Pins Better Auth's origin (trustedOrigins derive from it).
# Local: http://localhost:3000 — on Vercel: your production URL
# (previews can use https://${VERCEL_URL}).
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth; the provider activates automatically when set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Upstash Redis — activates the shared rate limiter across every
# serverless instance (Upstash console → database → REST API credentials).
# Without them, rate limiting stays per-instance in memory (dev/preview).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
